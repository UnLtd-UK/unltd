// Local-only Wrangler config used exclusively by the @astrojs/cloudflare
// adapter (see astro.config.mjs `cloudflare({ configPath: ... })`) for
// `astro dev` / `astro build` / `astro preview`.
//
// This is intentionally separate from wrangler.jsonc: that file's `main`
// points at ./dist/worker/index.js, which is produced by the unrelated
// `wrangler pages functions build` step (compiling functions/*.ts). The
// Cloudflare adapter needs to own its own worker entrypoint, so it can't
// share that file. Do NOT use this config for deployment — wrangler.jsonc
// remains the source of truth for `wrangler deploy`.
//
// IMPORTANT: do NOT add `"compatibility_flags": ["nodejs_compat"]` here.
// It causes on-demand (SSR) routes to render a literal "[object Object]"
// body instead of HTML. Root cause: nodejs_compat provides a native
// `process` global that satisfies astro core's `isNode` runtime check
// (`Object.prototype.toString.call(process) === "[object process]"`),
// which makes Astro pick its Node.js-specific async-iterable streaming
// path instead of the Web ReadableStream path — the resulting body isn't
// a valid Response BodyInit in workerd. Confirmed via `wrangler dev`
// directly against the built worker (dist/server), not just `astro
// preview`. If a future dependency genuinely needs node:fs/node:path at
// on-demand request time, this will need a different fix (e.g. removing
// the dependency from the on-demand route's import tree) rather than
// re-enabling this flag.
// CRITICAL: do NOT put "vars" here (e.g. DEV/SHOW_DRAFTS). Because this file
// is referenced UNCONDITIONALLY by astro.config.mjs's `configPath` for every
// `astro build` (including real production/draft CI builds, not just local
// dev), the Cloudflare adapter injects whatever is declared here into
// process.env — silently overriding the real CI job's SHOW_DRAFTS/DEV env
// vars. This caused draft/unpublished content to leak into the production
// static build (confirmed 2026-07-24: SHOW_DRAFTS=false in the shell/CI env
// was overridden to "true" by this file's old `vars` block). Local dev should
// keep using the existing documented workflow instead: `SHOW_DRAFTS=true npm
// run dev` (see README.md), which sets it via the shell/process env directly
// and is NOT clobbered as long as this file declares no vars.
{
  "name": "unltd",
  // Worker entry compiled by the adapter into dist/server/entry.mjs (which is
  // what wrangler.jsonc deploys). It re-exports EmDash's PluginBridge.
  "main": "./src/worker.ts",
  "compatibility_date": "2025-11-17",
  // Required by EmDash CMS (node:module, node:async_hooks, ...).
  "compatibility_flags": ["nodejs_compat"],
  // Local (miniflare) bindings for EmDash CMS (see astro.config.mjs). Binding
  // names must match d1()/r2() there. No database_id/bucket needed locally.
  "d1_databases": [{ "binding": "DB", "database_name": "unltd-emdash" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "unltd-emdash-media" }],
  // Worker Loader for EmDash's sandboxed (registry) plugins.
  "worker_loaders": [{ "binding": "LOADER" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
