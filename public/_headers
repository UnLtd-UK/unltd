# Prevent stale cached PDFs — ensure each deploy serves the latest build
/awards/downloads/*
  Cache-Control: public, max-age=0, must-revalidate

# Eligibility pages receive the applicant email as a query parameter via the
# Typeform redirect (e.g. /awards/not-yet-trading?email=...). A stale cached copy
# predates the email redaction in src/components/posthog.astro and re-sends the
# email to analytics and recordings. Never store these pages, so every load runs
# the current redaction. The more specific /awards/downloads/* rule above wins.
/awards/*
  Cache-Control: no-store

# Vite/Astro fingerprints these filenames on every build, so they're safe to cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fontsource files are also content-hashed
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/svg/*
  Cache-Control: public, max-age=31536000, immutable

# Not content-hashed: a replaced file under the same name needs a cache purge
/img/*
  Cache-Control: public, max-age=604800
