---
import DynamicIcon from "@components/DynamicIcon.astro";
import type { Home } from "@data/home";

const { data } = Astro.props as { data: Home["mission"] };
---

<div class="bg-violet-900 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl lg:max-w-none">
            <div class="flex flex-col">
                <h2
                    class="text-3xl font-bold tracking-tight text-violet-50 sm:text-4xl"
                >
                    {data.title}
                </h2>
                <div class="flex gap-4">
                    <p class="mt-4 text-md leading-8 text-violet-200 w-3/5">
                        {data.text}
                    </p>
                    <p class="mt-4 text-md leading-8 text-violet-200 w-3/5">
                        {data.callout}
                    </p>
                </div>
            </div>
            <div class="flex flex-col gap-4">
                <dl
                    class="mt-16 grid grid-cols-1 gap-0.5 overflow-hidden rounded-2xl text-center sm:grid-cols-2 lg:grid-cols-3"
                >
                    {
                        data.statistics.map((stat) => (
                            <div class="flex flex-col items-center bg-violet-950 gap-4 p-8">
                                <DynamicIcon
                                    icon={stat.icon}
                                    class="shrink-0 text-6xl text-violet-200"
                                />
                                <dt class="text-lg font-semibold tracking-tight text-violet-100">
                                    {stat.title}
                                </dt>
                                <dd class="text-sm font-semibold leading-6 text-violet-300">
                                    {stat.text}
                                </dd>
                            </div>
                        ))
                    }
                </dl>
            </div>
        </div>
    </div>
</div>
