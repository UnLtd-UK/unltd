---
// Signup form alongside the latest newsletter editions, so visitors can see
// what they're signing up to.
import Icon from "@components/Icon.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import SegmentBadges from "@components/newsletters/SegmentBadges.astro";
import type { RuntimeNewsletter } from "@lib/newsletters-runtime";
import { formatLongDate } from "@utils/post-format";

interface Props {
  newsletters: RuntimeNewsletter[];
  id?: string;
}

const { newsletters, id = "newsletter-showcase" } = Astro.props;
---

<section
  aria-labelledby={`${id}-heading`}
  class="rounded-2xl bg-linear-to-br from-violet-900 to-violet-950 p-6 ring-1 ring-violet-600/40 sm:p-10"
>
  <div
    class:list={[
      "grid gap-10",
      newsletters.length > 0 && "lg:grid-cols-2 lg:items-start lg:gap-14",
    ]}
  >
    <div>
      <p
        class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-400"
      >
        Newsletter
      </p>
      <h2
        id={`${id}-heading`}
        class="mt-3 text-3xl font-bold tracking-tight text-violet-100 sm:text-4xl"
      >
        Get our newsletter
      </h2>
      <p class="mt-4 text-lg leading-8 text-violet-300">
        News on our awards, events and the social entrepreneurs we support,
        straight to your inbox.
        {newsletters.length > 0 && " Here's what our latest editions look like."}
      </p>
      <div class="mt-6">
        <NewsletterSignup id={`${id}-form`} />
      </div>
    </div>

    {
      newsletters.length > 0 && (
        <div>
          <ul class="space-y-4">
            {newsletters.map((newsletter) => (
              <li>
                <a
                  href={`/newsletters/${newsletter.slug}`}
                  class="group block rounded-xl bg-violet-950/60 p-5 ring-1 ring-violet-700/60 transition hover:ring-violet-400/70"
                >
                  <time
                    datetime={newsletter.date}
                    class="text-sm font-medium text-violet-300"
                  >
                    {formatLongDate(newsletter.date)}
                  </time>
                  <span class="mt-1 block text-lg font-semibold text-violet-100 group-hover:text-white">
                    {newsletter.title}
                  </span>
                  {newsletter.subtitle && (
                    <span class="mt-1 block text-sm leading-relaxed text-violet-300/80 line-clamp-2">
                      {newsletter.subtitle}
                    </span>
                  )}
                  <span class="mt-3 block">
                    <SegmentBadges segments={newsletter.segments} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <a
            href="/newsletters"
            class="mt-5 inline-flex items-center gap-2 text-base font-semibold text-amber-400 hover:text-amber-300"
          >
            See all newsletters
            <Icon name="arrow-right" style="solid" class="text-sm" />
          </a>
        </div>
      )
    }
  </div>
</section>
