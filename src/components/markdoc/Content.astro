---
import Note from "@components/markdoc/Note.astro";
import Dropdown from "@components/markdoc/Dropdown.astro";
import Tip from "@components/markdoc/Tip.astro";
import Heading from "@components/markdoc/Heading.astro";
import EmbedLoaderHydrator from "@components/EmbedLoaderHydrator";
import HopeMapHydrator from "@components/HopeMapHydrator";
import { prepareMarkdown } from "@data/functions/prepareMarkdown.js";

import { marked } from "marked";

const { body } = Astro.props;
const preparedBody = prepareMarkdown(body);
const renderer = new marked.Renderer();

renderer.heading = function ({ tokens, depth, text }) {
  const idMatch = tokens[0].raw.match(/\(#(.*?)\)/);
  const id = idMatch ? idMatch[1] : text.toLowerCase().replace(/\s+/g, "-");
  const firstToken = tokens[0] as { text?: string; href?: string };

  let h = {
    level: depth,
    id: id,
    text: firstToken.text || text,
    href: firstToken.href || "", // Add default empty string if href is undefined
  };

  if ((depth === 2 || depth === 3) && h.href && h.href.startsWith("#")) {
    // "underline" is applied to satisfy axe's link-in-text-block check (distinct text-decoration from the heading) -
    // it has no visible effect since the anchor's only content is an sr-only span and a non-text svg icon.
    return `\n<h${h.level} id="${h.id}">${h.text}<a href="${h.href}" class="underline"><span class="sr-only">Link to this section</span><svg class="inline-block pl-2 h-5 w-5 text-violet-300 hover:text-violet-100" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"/></svg></a></h${h.level}>\n`;
  } else if (
    (depth === 2 || depth === 3) &&
    h.href &&
    !h.href.startsWith("#")
  ) {
    return `\n<a href="${h.href}" target=${h.href.startsWith("/") ? "" : "_blank"}><h${h.level}">${h.text}</h${h.level}></a>\n`;
  }
  return `<h${h.level}>${h.text}</h${h.level}>`;
};

// Custom link renderer to open external links in new tab and support button syntax
renderer.link = function ({ href, title, tokens }) {
  const parsedText = this.parser.parseInline(tokens);
  // Fall back to the URL itself so legacy/migrated content never renders an empty, unreadable link
  const text = parsedText.replace(/<[^>]*>/g, "").trim() ? parsedText : href;
  const titleAttr = title ? ` title="${title}"` : "";

  // Check if this is a button link (href starts with !)
  if (href && href.startsWith("!")) {
    const actualHref = href.slice(1); // Remove the ! prefix
    const isExternal =
      actualHref &&
      !actualHref.startsWith("/") &&
      !actualHref.startsWith("#") &&
      !actualHref.includes("unltd.org.uk");
    const targetAttr = isExternal
      ? ' target="_blank" rel="noopener noreferrer"'
      : "";
    return `<a href="${actualHref}"${titleAttr}${targetAttr} class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-4 py-2.5 text-sm font-semibold text-amber-950 shadow-sm hover:bg-amber-400 transition-colors no-underline">${text}</a>`;
  }

  // Check if link is external (not unltd.org.uk or relative)
  const isExternal =
    href &&
    !href.startsWith("/") &&
    !href.startsWith("#") &&
    !href.includes("unltd.org.uk");

  if (isExternal) {
    return `<a href="${href}"${titleAttr} target="_blank" rel="noopener noreferrer">${text}</a>`;
  }

  return `<a href="${href}"${titleAttr}>${text}</a>`;
};

// Custom image renderer to support per-image sizing, alignment, and corner
// styling from markdown. Content editors set the markdown image "title"
// (quoted text after the URL) to a space-separated combination of a size
// keyword, an alignment keyword, and/or "square" to control the image's
// width, horizontal position, and border radius. No title (or unrecognised
// words) keeps the default full-width, centred, rounded-corner behaviour.
//
//   ![Henry Smith Foundation logo](https://.../logo.png "half")
//   ![Henry Smith Foundation logo](https://.../logo.png "half left")
//   ![Henry Smith Foundation logo](https://.../logo.png "small right square")
//
// Two or more sized images placed back-to-back (each its own paragraph, with
// nothing else in between) are automatically laid out side by side as equal
// columns instead of stacked - no extra syntax needed, and the size keyword
// only matters as the opt-in trigger (an adjacent "half" + "third" pair
// still ends up as two equal columns). See groupAdjacentImageParagraphs().
//
// Widths and the "square" override are marked `!important` (Tailwind v4's
// trailing `!` syntax) because they otherwise tie in specificity with the
// `prose-img:w-full` / `prose-img:rounded-md` rules applied to every image in
// this container, and lose the cascade order tie-break.
const IMAGE_WIDTH_CLASSES: Record<string, string> = {
  half: "sm:w-1/2!",
  third: "sm:w-1/3!",
  quarter: "sm:w-1/4!",
  small: "max-w-xs!",
};

const IMAGE_ALIGN_CLASSES: Record<string, string> = {
  left: "ml-0 mr-auto",
  center: "mx-auto",
  centre: "mx-auto",
  right: "ml-auto mr-0",
};

const IMAGE_RADIUS_CLASSES: Record<string, string> = {
  square: "rounded-none!",
};

// Literal strings (not built at runtime) so Tailwind's content scanner emits
// these utilities - it can't see through buildImageTag()'s string-building.
// Row images use equal flex-basis columns rather than their own size keyword
// (half/third/quarter) - percentage widths summing to 100% leave no room for
// `gap`, which forces an unwanted wrap onto separate lines.
const IMAGE_ROW_CLASSES =
  "not-prose flex flex-col sm:flex-row gap-4 sm:gap-6 my-6 sm:items-start";
const IMAGE_ROW_ITEM_CLASSES = "min-w-0 sm:flex-1";

function getImageSizeKeyword(title: string | null | undefined) {
  const tokens = (title || "")
    .trim()
    .toLowerCase()
    .split(/\s+/)
    .filter(Boolean);
  return tokens.find((token) => token in IMAGE_WIDTH_CLASSES);
}

// `context: "row"` is used inside an auto-generated side-by-side row (below),
// where the flex container sizes/positions images rather than their own
// width and margin classes.
function buildImageTag(
  { href, title, text }: { href: string; title?: string | null; text: string },
  { context = "solo" }: { context?: "solo" | "row" } = {},
) {
  const tokens = (title || "")
    .trim()
    .toLowerCase()
    .split(/\s+/)
    .filter(Boolean);
  const sizeKey = tokens.find((token) => token in IMAGE_WIDTH_CLASSES);
  const alignKey = tokens.find((token) => token in IMAGE_ALIGN_CLASSES);
  const radiusKey = tokens.find((token) => token in IMAGE_RADIUS_CLASSES);

  // Only apply an alignment class once a size (or explicit alignment) is
  // requested - a full-width image has no room to be aligned within.
  const classes = [
    context === "row"
      ? IMAGE_ROW_ITEM_CLASSES
      : sizeKey
        ? IMAGE_WIDTH_CLASSES[sizeKey]
        : "",
    context === "solo" && (sizeKey || alignKey)
      ? IMAGE_ALIGN_CLASSES[alignKey ?? "center"]
      : "",
    radiusKey ? IMAGE_RADIUS_CLASSES[radiusKey] : "",
  ]
    .filter(Boolean)
    .join(" ");

  const classAttr = classes ? ` class="${classes}"` : "";

  return `<img src="${href}" alt="${text}"${classAttr} loading="lazy" />`;
}

renderer.image = function ({ href, title, text }) {
  return buildImageTag({ href, title, text });
};

// A "standalone sized image" is a paragraph containing nothing but one
// image with a recognised size keyword - the only thing eligible to be
// grouped into an auto-generated side-by-side row.
function isStandaloneSizedImage(token: any) {
  return (
    token?.type === "paragraph" &&
    token.tokens?.length === 1 &&
    token.tokens[0].type === "image" &&
    Boolean(getImageSizeKeyword(token.tokens[0].title))
  );
}

// A caption line directly above an image (no blank line separating them,
// e.g. pasted from a rich-text editor) parses as one paragraph containing
// both - split the sized image back out so it can still be row-grouped.
function splitTrailingImageFromParagraphs(tokens: any[]) {
  const result: any[] = [];

  for (const token of tokens) {
    if (
      token?.type !== "paragraph" ||
      !token.tokens ||
      token.tokens.length < 2
    ) {
      result.push(token);
      continue;
    }

    const lastToken = token.tokens[token.tokens.length - 1];
    if (lastToken?.type !== "image" || !getImageSizeKeyword(lastToken.title)) {
      result.push(token);
      continue;
    }

    const captionTokens = token.tokens.slice(0, -1);
    while (
      captionTokens.length &&
      captionTokens[captionTokens.length - 1].type === "text" &&
      !captionTokens[captionTokens.length - 1].text?.trim()
    ) {
      captionTokens.pop();
    }

    if (captionTokens.length) {
      result.push({ type: "paragraph", tokens: captionTokens });
    }
    result.push({ type: "paragraph", tokens: [lastToken] });
  }

  return result;
}

// Collapses runs of 2+ consecutive standalone sized images into a single
// flex-row HTML block (e.g. two adjacent "half" logos sit side by side
// instead of stacking). Runs of just one image are left untouched, so solo
// sized images keep rendering exactly as before. Blank-line "space" tokens
// between paragraphs don't break a run - they're dropped along with it.
function groupAdjacentImageParagraphs(tokens: any[]) {
  const result: any[] = [];
  let i = 0;

  while (i < tokens.length) {
    if (!isStandaloneSizedImage(tokens[i])) {
      result.push(tokens[i]);
      i += 1;
      continue;
    }

    const run = [tokens[i]];
    let next = i + 1;
    while (true) {
      let candidate = next;
      while (candidate < tokens.length && tokens[candidate]?.type === "space") {
        candidate += 1;
      }
      if (
        candidate < tokens.length &&
        isStandaloneSizedImage(tokens[candidate])
      ) {
        run.push(tokens[candidate]);
        next = candidate + 1;
      } else {
        break;
      }
    }

    if (run.length === 1) {
      result.push(run[0]);
      i += 1;
      continue;
    }

    const images = run
      .map((token) => buildImageTag(token.tokens[0], { context: "row" }))
      .join("\n");
    const rowHtml = `<div class="${IMAGE_ROW_CLASSES}">\n${images}\n</div>`;
    result.push({
      type: "html",
      raw: rowHtml,
      text: rowHtml,
      block: true,
      pre: false,
    });
    i = next;
  }

  return result;
}

// Legacy Word/Ghost-exported posts link footnote markers to `#_ftnN`/`#_ftnrefN`
// (or a bare numbered `#N`/`#name` pointing at a "References"/"Citations" list)
// but the actual named anchors those links depended on were dropped somewhere
// in the Ghost -> Directus migration, leaving dangling same-page links that
// axe/pa11y flag as broken. Since both halves of a `_ftn`/`_ftnref` pair are
// still present as links in the content, we can recover the missing anchor by
// tagging the *other* link in the pair with the id this one needs. For the
// simpler single-citation style, fall back to tagging the matching item in
// the References/Citations list.
function fixFootnoteAnchors(html: string) {
  const definedIds = new Set(
    [...html.matchAll(/\sid="([^"]+)"/g)].map((m) => m[1]),
  );
  const referencedIds = new Set(
    [...html.matchAll(/<a href="#([^"]+)"/g)].map((m) => m[1]),
  );
  const brokenIds = [...referencedIds].filter((id) => !definedIds.has(id));

  let fixed = html;

  for (const id of brokenIds) {
    const ftnMatch = id.match(/^_ftn(ref)?(\d+)$/);
    if (ftnMatch) {
      const mirrorId = ftnMatch[1]
        ? `_ftn${ftnMatch[2]}`
        : `_ftnref${ftnMatch[2]}`;
      const mirrorLink = new RegExp(`<a href="#${mirrorId}"([^>]*)>`);
      if (mirrorLink.test(fixed)) {
        fixed = fixed.replace(
          mirrorLink,
          `<a href="#${mirrorId}" id="${id}"$1>`,
        );
      } else {
        // No surviving counterpart anywhere in the content - the original
        // footnote text was lost in migration, so there's nothing to link to.
        fixed = fixed.replace(
          new RegExp(`<a href="#${id}"([^>]*)>([\\s\\S]*?)</a>`),
          "<span$1>$2</span>",
        );
      }
      continue;
    }

    const linkMatch = fixed.match(
      new RegExp(`<a href="#${id}"[^>]*>\\s*\\[?(\\d+)\\]?\\s*</a>`),
    );
    const refIndex = linkMatch ? parseInt(linkMatch[1], 10) : null;
    // Headings up to h3 are auto-wrapped in a self-link (see prepareMarkdown.ts),
    // so "References"/"Citations" isn't always immediately followed by the
    // closing tag - just require it to appear before the heading closes.
    const sectionMatch = fixed.match(
      /<h[1-6][^>]*>\s*(?:References|Citations)\b[\s\S]*?<\/h[1-6]>([\s\S]*?)(?=<h[1-6]|$)/i,
    );
    if (!refIndex || !sectionMatch) continue;

    let count = 0;
    const newSectionBody = sectionMatch[1].replace(/<(li|p)>/g, (tag, name) => {
      count += 1;
      return count === refIndex ? `<${name} id="${id}">` : tag;
    });
    if (newSectionBody !== sectionMatch[1]) {
      fixed =
        fixed.slice(0, sectionMatch.index) +
        sectionMatch[0].slice(
          0,
          sectionMatch[0].length - sectionMatch[1].length,
        ) +
        newSectionBody +
        fixed.slice(sectionMatch.index! + sectionMatch[0].length);
    }
  }

  return fixed;
}

marked.use({ renderer });
const html = fixFootnoteAnchors(
  marked.parser(
    groupAdjacentImageParagraphs(
      splitTrailingImageFromParagraphs(marked.lexer(preparedBody)),
    ),
  ),
);
---

<div
  set:html={html}
  class="prose
  prose-quoteless
    prose-slate
    dark:prose-invert
    lg:prose-lg
    prose-img:rounded-md
    prose-img:shadow-xs
    prose-img:w-full
    prose-figcaption:text-violet-300
    prose-figcaption:text-xs
    prose-ul:list-disc
    prose-ul:marker:text-violet-100
    prose-ol:marker:text-violet-100
    prose-a:font-bold
    prose-a:underline-offset-4
    prose-a:decoration-amber-500
    prose-a:decoration-1
    prose-a:hover:decoration-2
    [&_a[href^='#']]:scroll-mt-20
    prose-p:text-violet-200
    prose-li:text-violet-200
    prose-h1:text-violet-100
    prose-h2:text-violet-100
    prose-h3:text-violet-100
    prose-h4:text-violet-100
    prose-blockquote:border-l-violet-400
    prose-blockquote:px-6
    prose-blockquote:not-italic
    prose-blockquote:font-semibold
    prose-blockquote:text-xl
    prose-blockquote:relative
    prose-blockquote:leading-8
    [&>figure>blockquote]:border-l-violet-400
    [&>figure>blockquote]:px-6
    [&>figure>blockquote]:not-italic
    [&>figure>blockquote]:font-semibold
    [&>figure>blockquote]:text-xl
    [&>figure>blockquote]:relative
    [&>figure>blockquote]:leading-8
    [&_details]:border
    [&_details]:border-violet-700/30
    [&_details]:rounded-lg
    [&_details]:p-4
    [&_details]:mb-4
    [&_details_summary]:cursor-pointer
    [&_details_summary]:font-semibold
    [&_details_summary]:text-violet-100
    [&_details_summary]:select-none
    [&_details_summary]:flex
    [&_details_summary]:items-center
    [&_details_summary]:gap-2
    [&_details_summary]:transition-colors
    [&_details_summary:hover]:text-violet-300
    [&_details_summary::after]:content-['+']
    [&_details_summary::after]:ml-auto
    [&_details_summary::after]:text-xl
    [&_details_summary::after]:font-normal
    [&_details_summary::after]:text-violet-400
    [&_details[open]_summary::after]:content-['-']
    [&_details>*:not(summary)]:mt-4"
/>

<!-- Hydrate embed placeholders with React EmbedLoader components -->
<EmbedLoaderHydrator client:load />

<!-- Hydrate Hope Map embeds in blog post content -->
<HopeMapHydrator client:load />
