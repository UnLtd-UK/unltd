---
import Note from "@components/markdoc/Note.astro";
import Dropdown from "@components/markdoc/Dropdown.astro";
import Tip from "@components/markdoc/Tip.astro";
import Heading from "@components/markdoc/Heading.astro";
import EmbedLoaderHydrator from "@components/EmbedLoaderHydrator";
import HopeMapHydrator from "@components/HopeMapHydrator";
import { prepareMarkdown } from "@data/functions/prepareMarkdown.js";

import { marked } from "marked";

const { body } = Astro.props;
const preparedBody = prepareMarkdown(body);
const renderer = new marked.Renderer();

renderer.heading = function ({ tokens, depth, text }) {
  const idMatch = tokens[0].raw.match(/\(#(.*?)\)/);
  const id = idMatch ? idMatch[1] : text.toLowerCase().replace(/\s+/g, "-");
  const firstToken = tokens[0] as { text?: string; href?: string };

  let h = {
    level: depth,
    id: id,
    text: firstToken.text || text,
    href: firstToken.href || "", // Add default empty string if href is undefined
  };

  if ((depth === 2 || depth === 3) && h.href && h.href.startsWith("#")) {
    return `\n<h${h.level} id="${h.id}">${h.text}<a href="${h.href}" class="no-underline"><svg class="inline-block pl-2 h-5 w-5 text-violet-300 hover:text-violet-100" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"/></svg></a></h${h.level}>\n`;
  } else if (
    (depth === 2 || depth === 3) &&
    h.href &&
    !h.href.startsWith("#")
  ) {
    return `\n<a href="${h.href}" target=${h.href.startsWith("/") ? "" : "_blank"}><h${h.level}">${h.text}</h${h.level}></a>\n`;
  }
  return `<h${h.level}>${h.text}</h${h.level}>`;
};

// Custom link renderer to open external links in new tab and support button syntax
renderer.link = function ({ href, title, tokens }) {
  const text = this.parser.parseInline(tokens);
  const titleAttr = title ? ` title="${title}"` : "";

  // Check if this is a button link (href starts with !)
  if (href && href.startsWith("!")) {
    const actualHref = href.slice(1); // Remove the ! prefix
    const isExternal =
      actualHref &&
      !actualHref.startsWith("/") &&
      !actualHref.startsWith("#") &&
      !actualHref.includes("unltd.org.uk");
    const targetAttr = isExternal
      ? ' target="_blank" rel="noopener noreferrer"'
      : "";
    return `<a href="${actualHref}"${titleAttr}${targetAttr} class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-4 py-2.5 text-sm font-semibold text-amber-950 shadow-sm hover:bg-amber-400 transition-colors no-underline">${text}</a>`;
  }

  // Check if link is external (not unltd.org.uk or relative)
  const isExternal =
    href &&
    !href.startsWith("/") &&
    !href.startsWith("#") &&
    !href.includes("unltd.org.uk");

  if (isExternal) {
    return `<a href="${href}"${titleAttr} target="_blank" rel="noopener noreferrer">${text}</a>`;
  }

  return `<a href="${href}"${titleAttr}>${text}</a>`;
};

// Custom image renderer to support per-image sizing, alignment, and corner
// styling from markdown. Content editors set the markdown image "title"
// (quoted text after the URL) to a space-separated combination of a size
// keyword, an alignment keyword, and/or "square" to control the image's
// width, horizontal position, and border radius. No title (or unrecognised
// words) keeps the default full-width, centred, rounded-corner behaviour.
//
//   ![Henry Smith Foundation logo](https://.../logo.png "half")
//   ![Henry Smith Foundation logo](https://.../logo.png "half left")
//   ![Henry Smith Foundation logo](https://.../logo.png "small right square")
//
// Widths and the "square" override are marked `!important` (Tailwind v4's
// trailing `!` syntax) because they otherwise tie in specificity with the
// `prose-img:w-full` / `prose-img:rounded-md` rules applied to every image in
// this container, and lose the cascade order tie-break.
const IMAGE_WIDTH_CLASSES: Record<string, string> = {
  half: "sm:w-1/2!",
  third: "sm:w-1/3!",
  quarter: "sm:w-1/4!",
  small: "max-w-xs!",
};

const IMAGE_ALIGN_CLASSES: Record<string, string> = {
  left: "ml-0 mr-auto",
  center: "mx-auto",
  centre: "mx-auto",
  right: "ml-auto mr-0",
};

const IMAGE_RADIUS_CLASSES: Record<string, string> = {
  square: "rounded-none!",
};

renderer.image = function ({ href, title, text }) {
  const tokens = (title || "")
    .trim()
    .toLowerCase()
    .split(/\s+/)
    .filter(Boolean);
  const sizeKey = tokens.find((token) => token in IMAGE_WIDTH_CLASSES);
  const alignKey = tokens.find((token) => token in IMAGE_ALIGN_CLASSES);
  const radiusKey = tokens.find((token) => token in IMAGE_RADIUS_CLASSES);

  // Only apply an alignment class once a size (or explicit alignment) is
  // requested - a full-width image has no room to be aligned within.
  const classes = [
    sizeKey ? IMAGE_WIDTH_CLASSES[sizeKey] : "",
    sizeKey || alignKey ? IMAGE_ALIGN_CLASSES[alignKey ?? "center"] : "",
    radiusKey ? IMAGE_RADIUS_CLASSES[radiusKey] : "",
  ]
    .filter(Boolean)
    .join(" ");

  const classAttr = classes ? ` class="${classes}"` : "";

  return `<img src="${href}" alt="${text}"${classAttr} loading="lazy" />`;
};

marked.use({ renderer });
const html = marked.parse(preparedBody);
---

<div
  set:html={html}
  class="prose
  prose-quoteless
    prose-slate
    dark:prose-invert
    lg:prose-lg
    prose-img:rounded-md
    prose-img:shadow-xs
    prose-img:w-full
    prose-figcaption:text-violet-300
    prose-figcaption:text-xs
    prose-ul:list-disc
    prose-ul:marker:text-violet-100
    prose-ol:marker:text-violet-100
    prose-a:font-bold
    prose-a:underline-offset-4
    prose-a:decoration-amber-500
    prose-a:decoration-1
    prose-a:hover:decoration-2
    [&_a[href^='#']]:scroll-mt-20
    prose-p:text-violet-200
    prose-li:text-violet-200
    prose-h1:text-violet-100
    prose-h2:text-violet-100
    prose-h3:text-violet-100
    prose-h4:text-violet-100
    prose-blockquote:border-l-violet-400
    prose-blockquote:px-6
    prose-blockquote:not-italic
    prose-blockquote:font-semibold
    prose-blockquote:text-xl
    prose-blockquote:relative
    prose-blockquote:leading-8
    [&>figure>blockquote]:border-l-violet-400
    [&>figure>blockquote]:px-6
    [&>figure>blockquote]:not-italic
    [&>figure>blockquote]:font-semibold
    [&>figure>blockquote]:text-xl
    [&>figure>blockquote]:relative
    [&>figure>blockquote]:leading-8
    [&_details]:border
    [&_details]:border-violet-700/30
    [&_details]:rounded-lg
    [&_details]:p-4
    [&_details]:mb-4
    [&_details_summary]:cursor-pointer
    [&_details_summary]:font-semibold
    [&_details_summary]:text-violet-100
    [&_details_summary]:select-none
    [&_details_summary]:flex
    [&_details_summary]:items-center
    [&_details_summary]:gap-2
    [&_details_summary]:transition-colors
    [&_details_summary:hover]:text-violet-300
    [&_details_summary::after]:content-['+']
    [&_details_summary::after]:ml-auto
    [&_details_summary::after]:text-xl
    [&_details_summary::after]:font-normal
    [&_details_summary::after]:text-violet-400
    [&_details[open]_summary::after]:content-['-']
    [&_details>*:not(summary)]:mt-4"
/>

<!-- Hydrate embed placeholders with React EmbedLoader components -->
<EmbedLoaderHydrator client:load />

<!-- Hydrate Hope Map embeds in blog post content -->
<HopeMapHydrator client:load />
