---
import { Image } from "astro:assets";
import Icon from "@components/Icon.astro";
import IconBig from "@components/awards/cards/IconBig.astro";
import type { ProgrammeEntry } from "@data/programmes.ts";

const { programme, styles } = Astro.props as {
  programme: ProgrammeEntry;
  styles: Record<string, string>;
};

const paragraphs = programme.subtitle
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<div class={`relative isolate overflow-hidden ${styles.bg} py-20`}>
  {
    programme.image && (
      <Image
        src={programme.image.src}
        alt=""
        width={1920}
        height={1080}
        format="webp"
        layout="full-width"
        fetchpriority="high"
        loading="eager"
        class="absolute inset-0 -z-10 h-full w-full object-cover object-right md:object-center brightness-50 blur-xs opacity-30"
      />
    )
  }
  <div
    class="hidden sm:absolute sm:-top-10 sm:right-1/2 sm:-z-10 sm:mr-10 sm:block sm:transform-gpu sm:blur-3xl"
    aria-hidden="true"
  >
    <div
      class={`aspect-1097/845 w-274.25 bg-linear-to-tr ${styles.bg} opacity-20`}
      style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
    >
    </div>
  </div>
  <div
    class="absolute -top-52 left-1/2 -z-10 transform-gpu blur-3xl sm:-top-112 sm:ml-16 sm:transform-gpu"
    aria-hidden="true"
  >
    <div
      class={`aspect-1097/845 w-274.25 bg-linear-to-tr ${styles.bg1} opacity-20`}
      style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
    >
    </div>
  </div>
  <div class="mx-auto max-w-7xl px-6 lg:px-8 xl:mb-10">
    <div class="col-span-4 flex flex-col gap-8 lg:flex-row">
      <div class="flex flex-col gap-16">
        <IconBig name={programme.title} icon={programme.icon} styles={styles} />
        <div class="flex flex-row gap-8 items-center">
          <div class="flex flex-col gap-3">
            <div class="flex flex-row gap-4">
              <div
                class={`flex flex-inline items-center gap-3 pr-3 border-r ${styles.border2} ${styles.text}`}
              >
                <Icon
                  name="award"
                  style="solid"
                  class={`text-base ${styles.text2}`}
                /><span
                  class={`text-xs tracking-widest uppercase font-bold ${styles.text2}`}
                  >Award Programme</span
                >
              </div>
            </div>

            <h1 class={`text-6xl font-bold ${styles.text} ${styles.font}`}>
              {programme.title}
            </h1>
          </div>
        </div>
        <div class="flex flex-col gap-6">
          <div class="flex max-w-4xl flex-col gap-4">
            {
              paragraphs.map((paragraph) => (
                <p
                  class={`text-xl leading-relaxed ${styles.text2} ${styles.font}`}
                >
                  {paragraph}
                </p>
              ))
            }
          </div>
          <a
            href="/how-unltd-is-funded"
            class={`${styles.text2} ${styles.font} text-xs underline-1 underline`}
          >
            Find out where this funding comes from.
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
