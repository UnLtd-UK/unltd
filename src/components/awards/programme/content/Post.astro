---
const { post, styles } = Astro.props as { post: PostEntry; styles: any };
import { Image } from "astro:assets";
import type { PostEntry } from "@data/posts.ts";
import { formatShortDate } from "@utils/post-format";

const authorNames = post.authors.map((author) => author.name).join(", ");
---

<article class="group relative flex flex-col">
    <div
        class={`relative aspect-video w-full overflow-hidden rounded-2xl shadow-lg`}
    >
        <Image
            src={post.image
                ? post.image.src
                : `/img/blog/${post.tag?.slug ?? "default"}.webp`}
            alt={post.title}
            width={800}
            height={450}
            format="webp"
            layout="full-width"
            class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
        />
        <div
            class={`absolute inset-0 bg-linear-to-t ${styles.gradient} opacity-60`}
        >
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-6">
            <div
                class={`flex items-center gap-x-2 text-xs ${styles.text} opacity-90`}
            >
                <time datetime={post.date}>
                    {formatShortDate(post.date)}
                </time>
                {
                    authorNames && (
                        <>
                            <span>·</span>
                            <span>{authorNames}</span>
                        </>
                    )
                }
            </div>
        </div>
    </div>
    <div class="mt-4">
        <h3
            class={`text-base font-semibold leading-6 ${styles.text} group-hover:opacity-80 transition`}
        >
            <a href={`/blog/${post.slug}`}>
                <span class="absolute inset-0"></span>
                {post.title}
            </a>
        </h3>
        {
            post.subtitle && (
                <p
                    class={`mt-2 line-clamp-2 text-sm leading-6 ${styles.text2}`}
                >
                    {post.subtitle}
                </p>
            )
        }
    </div>
</article>
