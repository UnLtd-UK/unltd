---
import { Image } from "astro:assets";
const { image, styles } = Astro.props;
---

<div class="flex-none aspect-video h-44 lg:h-96 bg-white rounded-lg shadow-lg">
    <Image
        src={`https://unltd.directus.app/assets/${image.id.id}`}
        alt="Placeholder Image"
        width={768}
        height={432}
        layout="full-width"
        class="w-full h-full object-cover rounded-lg"
    />
</div>
