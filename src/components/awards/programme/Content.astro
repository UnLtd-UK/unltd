---
import Video from "@components/awards/programme/content/Video.astro";
import Container from "@components/Container.astro";
import PortableContent from "@components/emdash/PortableContent.astro";
import type { ProgrammeEntry } from "@data/programmes.ts";

const { styles, programme } = Astro.props as {
    styles: Record<string, string>;
    programme: ProgrammeEntry;
};
---

<div class={`py-16 sm:py-24 ${styles.bg2}`}>
    <Container>
        <div class="mx-auto max-w-2xl lg:max-w-none">
            <div class="text-center mb-12">
                <p
                    class={`mt-2 text-3xl font-bold tracking-tight ${styles.text} sm:text-4xl`}
                >
                    Stories & Media
                </p>
                <p
                    class={`mt-4 text-lg leading-8 ${styles.text2} max-w-2xl mx-auto`}
                >
                    Discover stories of Award Winners from this programme
                </p>
            </div>

            {
                programme.videos.length > 0 && (
                    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
                        {programme.videos.map((video) => (
                            <Video video={video} styles={styles} />
                        ))}
                    </div>
                )
            }

            {
                programme.content.length > 0 && (
                    <div class="mt-12">
                        <PortableContent value={programme.content} />
                    </div>
                )
            }
        </div>
    </Container>
</div>
