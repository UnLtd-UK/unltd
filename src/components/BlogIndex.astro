---
import Template from "@layouts/Template.astro";
import Container from "@components/Container.astro";
import Default from "@components/heroes/Default.astro";
import Post from "@components/Post.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Icon from "@components/Icon.astro";
import type { PostEntry } from "@data/posts";

interface Props {
  posts: PostEntry[];
  /** Every year with a post, newest first, for the tabs. */
  years: number[];
  /** The year being shown; all posts when omitted. */
  year?: number;
}

const name = "Blog";
const description = "Read our posts.";
const { posts, years, year } = Astro.props;

// Absolute, because Breadcrumbs uses them as they are and a relative one
// would resolve against /blog/<year>.
const breadcrumbs = [
  { name, path: "/blog" },
  ...(year ? [{ name: year, path: `/blog/${year}` }] : []),
];
---

<Template name={name} description={description}>
  <Container>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
    <Default name={name} description={description} />
    <div>
      <div class="grid grid-cols-1 sm:hidden">
        <!-- Use an "onChange" listener to redirect the user to the selected tab URL. -->
        <select
          aria-label="Select a tab"
          id="picker"
          class="col-start-1 row-start-1 w-full appearance-none rounded-md bg-white py-2 pr-8 pl-3 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600"
        >
          {
            years.map((year) => (
              <option
                value={`/blog/${year}`}
                selected={
                  Astro.url.pathname === `/blog/${year}` ||
                  Astro.url.pathname === `/blog/${year}/`
                }
              >
                {year}
              </option>
            ))
          }
        </select>
        <Icon
          name="chevron-down"
          style="solid"
          class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-violet-500"
        />
      </div>
      <div class="hidden sm:block">
        <div class="border-b border-violet-800">
          <nav class="-mb-px flex space-x-8" aria-label="Tabs">
            <a
              href={`/blog`}
              class={`border-b-2 border-transparent px-1 py-4 text-sm font-medium whitespace-nowrap text-violet-400 hover:border-violet-300 hover:text-violet-300 ${(Astro.url.pathname === "/blog" || Astro.url.pathname === "/blog/") && "text-violet-200 border-violet-400"}`}
              >All</a
            >
            {
              years.map((year) => (
                <a
                  href={`/blog/${year}`}
                  class={`border-b-2 border-transparent px-1 py-4 text-sm font-medium whitespace-nowrap text-violet-400 hover:border-violet-300 hover:text-violet-300 ${(Astro.url.pathname === `/blog/${year}` || Astro.url.pathname === `/blog/${year}/`) && "text-violet-200 border-violet-400"}`}
                >
                  {year}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </div>

    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <Post post={post} />)}
    </ul>
  </Container>
</Template>

<script>
  // Go to the chosen year's page when the mobile year picker changes.
  const picker = document.getElementById("picker");
  if (picker instanceof HTMLSelectElement) {
    picker.addEventListener("change", () => {
      window.location.href = picker.value;
    });
  }
</script>
