---
import { Image } from "astro:assets";
import type { PostEntry } from "@data/posts";
import { formatAuthors, formatPostDate } from "@utils/post-format";

const { post } = Astro.props as { post: PostEntry };
const authors = formatAuthors(post.authors);
---

<section
    class="flex flex-col md:flex-row gap-10 items-center my-10 rounded-2xl bg-linear-to-r from-violet-950 to-violet-900 p-4"
>
    <div class="basis-1/2">
        {
            post.image && (
                <figure class="flex flex-col gap-2">
                    <Image
                        src={post.image.src}
                        alt={post.image.alt}
                        width={1600}
                        height={900}
                        format="webp"
                        layout="full-width"
                        fetchpriority="high"
                        loading="eager"
                        class=" rounded-2xl"
                    />
                    {post.image.caption && (
                        <figcaption class="text-xs text-violet-300">
                            {post.image.caption}
                        </figcaption>
                    )}
                </figure>
            )
        }
    </div>

    <div class="flex flex-col gap-4 basis-1/2">
        <div class="flex items-center">
            {
                post.tag && (
                    <span class="rounded-full text-xs bg-violet-100 dark:bg-violet-800 px-3 py-1.5 font-medium text-violet-600 dark:text-violet-300 border border-violet-600">
                        {post.tag.label}
                    </span>
                )
            }
            {
                post.status === "draft" && (
                    <span class="ml-2 relative z-10 rounded-full bg-red-100 dark:bg-red-900 px-3 py-1.5 font-medium text-red-600 dark:text-red-300">
                        DRAFT
                    </span>
                )
            }
            {
                post.status === "scheduled" && (
                    <span class="ml-2 relative z-10 rounded-full bg-blue-100 dark:bg-blue-900 px-3 py-1.5 font-medium text-blue-600 dark:text-blue-300">
                        SCHEDULED
                    </span>
                )
            }
        </div>
        <div class="group">
            <h3
                class="text-4xl font-semibold text-violet-700 dark:text-violet-100"
            >
                <span class=""></span>
                {post.title}
            </h3>
            {
                post.subtitle && (
                    <p class="text-2xl leading-8 text-violet-600 dark:text-violet-300">
                        {post.subtitle}
                    </p>
                )
            }
        </div>
        <div>
            {
                authors && (
                    <p class="text-xs text-violet-600 dark:text-violet-400">
                        By <span class="text-violet-700 dark:text-violet-300">{authors}</span>
                    </p>
                )
            }
            <time
                datetime={post.date}
                class="text-violet-600 dark:text-violet-400 text-xs"
            >
                Published <span class="text-violet-700 dark:text-violet-300"
                    >{formatPostDate(post.date)}</span
                >
            </time>
        </div>
    </div>
</section>

<div class="relative">
    <div class="absolute inset-0 flex items-center" aria-hidden="true">
        <div class="w-full border-t border-violet-900"></div>
    </div>
</div>
