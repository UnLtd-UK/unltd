---
import { Image } from "astro:assets";
import Icon from "@components/Icon.astro";
import type { PostEntry } from "@data/posts";
import { formatAuthors, formatPostDate } from "@utils/post-format";

const { post } = Astro.props as { post: PostEntry };
const authors = formatAuthors(post.authors);
---

<li class="col-span-1 divide-y divide-gray-200 rounded-lg">
    <a href={`/blog/${post.slug}`}>
        <article
            class="flex flex-col items-start justify-between transition hover:bg-violet-100 dark:hover:bg-violet-900 hover:outline-violet-200 hover:dark:outline-violet-800 p-6 rounded-2xl"
        >
            <div
                class="relative w-full h-64 bg-violet-800 rounded-2xl border border-violet-600"
            >
                {
                    post.image ? (
                        <Image
                            src={post.image.src}
                            alt=""
                            width={800}
                            height={512}
                            format="webp"
                            layout="full-width"
                            class="absolute inset-0 w-full h-full object-cover rounded-2xl"
                        />
                    ) : (
                        <div class="flex justify-center items-center h-64">
                            <Icon
                                name="image-slash"
                                style="solid"
                                class="text-4xl text-violet-400"
                            />
                        </div>
                    )
                }
            </div>
            <div class="max-w-xl">
                <div class="mt-8 flex items-center gap-x-4 text-xs">
                    <time
                        datetime={post.date}
                        class="text-violet-600 dark:text-violet-300"
                    >
                        {formatPostDate(post.date)}
                    </time>
                    {
                        post.tag && (
                            <span class="relative z-10 rounded-full bg-violet-100 dark:bg-violet-900 px-3 py-1.5 font-medium text-violet-600 dark:text-violet-300">
                                {post.tag.label}
                            </span>
                        )
                    }
                    {
                        post.status === "draft" && (
                            <span class="relative z-10 rounded-full bg-red-100 dark:bg-red-900 px-3 py-1.5 font-medium text-red-600 dark:text-red-300">
                                DRAFT
                            </span>
                        )
                    }
                    {
                        post.status === "scheduled" && (
                            <span class="relative z-10 rounded-full bg-blue-100 dark:bg-blue-900 px-3 py-1.5 font-medium text-blue-600 dark:text-blue-300">
                                SCHEDULED
                            </span>
                        )
                    }
                </div>

                <div class="group relative flex flex-col gap-1">
                    <h3
                        class="mt-3 text-lg font-semibold leading-6 text-violet-700 dark:text-violet-200"
                    >
                        <span class="absolute inset-0"></span>
                        {post.title}
                    </h3>
                    {
                        authors && (
                            <p class="text-xs text-violet-700 dark:text-violet-300">
                                By {authors}
                            </p>
                        )
                    }
                </div>
                {
                    post.subtitle && (
                        <p class="mt-5 text-sm leading-6 text-violet-600 dark:text-violet-300">
                            {post.subtitle}
                        </p>
                    )
                }
            </div>
        </article>
    </a>
</li>
