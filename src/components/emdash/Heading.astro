---
// EmDash stores body headings one level lower than the page's rendered
// outline (the page title is the hero heading), so shift every level down by
// one. h2/h3 also get an id and a self-link, matching the old Markdown renderer.
const { node } = Astro.props;

const level = Math.min(Number(String(node.style).slice(1)) + 1, 6);
const Tag = `h${level}` as "h2";
const id: string | undefined = node.headingId;
const linked = id && (level === 2 || level === 3);
---

<Tag id={linked ? id : undefined}>
  <slot />
  {
    linked && (
      <a href={`#${id}`} class="underline">
        <span class="sr-only">Link to this section</span>
        <svg
          class="inline-block pl-2 h-5 w-5 text-violet-300 hover:text-violet-100"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
        </svg>
      </a>
    )
  }
</Tag>
