---
import { sanitizeHref } from "emdash";

// External links open in a new tab, matching the old Markdown renderer.
const { node } = Astro.props;
const href = sanitizeHref(node?.markDef?.href);
const isExternal =
  /^https?:\/\//.test(href) && !href.includes("unltd.org.uk");
---

<a
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
>
  <slot />
</a>
