---
import Icon from "./Icon.astro";

const LINK_HREF = "/fostering-innovation-accelerator";
const DISMISSED_KEY = "fca-banner-dismissed";

// Paths where the banner should always show, ignoring any previous dismissal
// (the dismiss button is also hidden on these paths, since it can't be dismissed here)
const FORCE_VISIBLE_PATHS = ["/awards"];

// Don't show the banner when the user is already on the page it links to
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isOnLinkedPage = currentPath === LINK_HREF;
const isForceVisiblePage = FORCE_VISIBLE_PATHS.some(
    (path) => currentPath === path || currentPath.startsWith(`${path}/`),
);
---

<!--
  Make sure you add some bottom padding to pages that include a sticky banner like this to prevent
  your content from being obscured when the user scrolls to the bottom of the page.
-->{
    !isOnLinkedPage && (
        <div
            x-data={`{ show: true, init() { this.show = ${isForceVisiblePage} || localStorage.getItem('${DISMISSED_KEY}') !== '1' } }`}
            x-show="show"
            x-cloak
            class="pointer-events-none fixed inset-x-0 bottom-0 sm:flex sm:justify-center sm:px-6 sm:pb-5 lg:px-8"
        >
            <div class="pointer-events-auto flex items-center justify-between gap-x-6 bg-amber-600 px-6 py-2.5 sm:rounded-full sm:py-3 sm:pr-3.5 sm:pl-4 dark:bg-amber-500 dark:inset-ring dark:inset-ring-white/10 transition-transform duration-200 ease-out hover:scale-101">
                <p class="text-sm/6 text-amber-950">
                    <a href={LINK_HREF}>
                        <strong class="font-semibold">
                            Fostering Innovation Accelerator
                        </strong>
                        <svg
                            viewBox="0 0 2 2"
                            aria-hidden="true"
                            class="mx-2 inline size-0.5 fill-current"
                        >
                            <circle r="1" cx="1" cy="1" />
                        </svg>
                        A new accelerator for social entrepreneurs tackling
                        foster care challenges at a systemic level
                        <svg
                            viewBox="0 0 2 2"
                            aria-hidden="true"
                            class="mx-2 inline size-0.5 fill-current"
                        >
                            <circle r="1" cx="1" cy="1" />
                        </svg>
                        <span class="underline">Learn more</span>
                    </a>
                </p>
                {!isForceVisiblePage && (
                    <button
                        type="button"
                        class="-m-1.5 flex-none cursor-pointer rounded-full p-1.5 transition-colors hover:bg-amber-950/10"
                        aria-label="Dismiss"
                        @click={`show = false; localStorage.setItem('${DISMISSED_KEY}', '1')`}
                    >
                        <span class="sr-only">Dismiss</span>
                        <Icon
                            name="xmark"
                            style="solid"
                            class="size-5 text-amber-950"
                        />
                    </button>
                )}
            </div>
        </div>
    )
}
