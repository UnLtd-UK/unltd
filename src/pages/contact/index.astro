---
import Template from "@layouts/Template.astro";
import Container from "@components/Container.astro";
import Default from "@components/heroes/Default.astro";
import { forms } from "@data/forms.ts";
import Breadcrumbs from "@components/Breadcrumbs.astro";

const name = "Choose The Right Form";
const slug = "contact";

const top = {
  name,
  slug,
  description: "Get in touch, we're here to help",
  breadcrumbs: [
    {
      name,
      path: slug,
    },
  ],
};
---

<Template name={top.name} description={top.description}>
  <Container>
    <Breadcrumbs breadcrumbs={top.breadcrumbs} />
    <Default name={top.name} description={top.description} />
    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        forms.map((form) => (
          <li class="col-span-1 divide-y p-10 divide-violet-200 rounded-lg border border-violet-700 bg-violet-900 shadow-xs">
            <div class="flex h-full flex-col justify-between">
              <div class="flex flex-col gap-4">
                <h3 class="text-base font-semibold leading-7 text-violet-800 dark:text-violet-200">
                  {form.name}
                </h3>
                <p class="leading-5 text-xs text-violet-300">
                  {form.description}
                </p>
              </div>
              <p class="mt-4">
                <a
                  href={`/contact/${form.slug}`}
                  class="text-sm font-semibold leading-6 text-amber-400"
                >
                  Go to form <span aria-hidden="true">&rarr;</span>
                </a>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</Template>
