---
import Template from "@layouts/Template.astro";
import Container from "@components/Container.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Icon from "@components/Icon.astro";
import PortableContent from "@components/emdash/PortableContent.astro";

import { getAllNewsletters, getNewsletter } from "@lib/newsletters-runtime";
import { CMS_PAGE_CACHE } from "@lib/route-cache";
import { formatLongDate } from "@utils/post-format";

// Rendered on demand so a new or edited newsletter, and an EmDash draft
// preview, show without a rebuild. Route caching keeps it fast: EmDash tags
// each response, and publishing purges it.
export const prerender = false;

const slug = Astro.params.newsletter;
if (!slug) return Astro.rewrite("/404");

const [{ newsletter, isPreview, cacheHint }, { newsletters, cacheHints }] =
  await Promise.all([getNewsletter(slug), getAllNewsletters()]);
if (!newsletter) return Astro.rewrite("/404");

if (Astro.cache?.enabled) {
  // A draft preview or an editor's edit-mode view is for one person, not for the shared cache.
  const editing = Astro.cookies.get("emdash-edit-mode")?.value === "true";
  if (isPreview || editing) Astro.cache.set(false);
  else {
    // The neighbouring editions are linked at the bottom, so they are tagged too.
    [cacheHint, ...cacheHints].forEach((hint) => Astro.cache.set(hint));
    Astro.cache.set(CMS_PAGE_CACHE);
  }
}

const { title, subtitle, content, date, edit } = newsletter;

// The list is newest first, so the edition before this one is the next in the list.
const index = newsletters.findIndex((item) => item.slug === newsletter.slug);
const newer = index > 0 ? newsletters[index - 1] : null;
const older = index >= 0 ? (newsletters[index + 1] ?? null) : null;

const breadcrumbs = [
  { name: "Newsletters", path: "/newsletters" },
  { name: title, path: `/newsletters/${newsletter.slug}` },
];
---

<Template name={title} description={subtitle}>
  <Container>
    <Breadcrumbs breadcrumbs={breadcrumbs} />

    <article class="mx-auto max-w-3xl py-12 sm:py-16">
      <header class="text-center">
        <img
          src="/svg/unltd-logo-white.svg"
          alt="UnLtd"
          width="140"
          height="40"
          class="mx-auto h-10 w-auto"
        />
        <p class="mt-6 text-xs font-semibold uppercase tracking-[0.25em] text-amber-400">
          The UnLtd newsletter
        </p>
        <div class="mx-auto mt-6 flex items-center gap-4" aria-hidden="true">
          <span class="h-px flex-1 bg-violet-700"></span>
          <span class="h-1.5 w-1.5 rotate-45 bg-amber-400"></span>
          <span class="h-px flex-1 bg-violet-700"></span>
        </div>
        <time datetime={date} class="mt-6 block text-sm text-violet-300">
          {formatLongDate(date)}
        </time>
        <h1
          class="mt-4 text-4xl font-bold tracking-tight text-violet-100 sm:text-5xl"
          {...edit.title}
        >
          {title}
        </h1>
        {
          subtitle && (
            <p
              class="mt-5 text-xl leading-8 text-violet-300"
              {...edit.subtitle}
            >
              {subtitle}
            </p>
          )
        }
      </header>

      <div
        class="mt-12 rounded-2xl bg-violet-900/30 p-6 ring-1 ring-violet-700/50 sm:p-10"
      >
        <PortableContent value={content} />
      </div>

      <nav
        aria-label="More newsletters"
        class="mt-12 grid gap-4 border-t border-violet-800 pt-8 sm:grid-cols-2"
      >
        {
          older ? (
            <a
              href={`/newsletters/${older.slug}`}
              class="group rounded-xl p-4 ring-1 ring-violet-700/50 transition hover:ring-violet-400/60"
            >
              <span class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-violet-400">
                <Icon name="arrow-right" style="solid" class="rotate-180 text-xs" />
                Previous edition
              </span>
              <span class="mt-2 block font-semibold text-violet-100 group-hover:text-white">
                {older.title}
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          newer && (
            <a
              href={`/newsletters/${newer.slug}`}
              class="group rounded-xl p-4 text-right ring-1 ring-violet-700/50 transition hover:ring-violet-400/60 sm:col-start-2"
            >
              <span class="flex items-center justify-end gap-2 text-xs font-semibold uppercase tracking-wide text-violet-400">
                Next edition
                <Icon name="arrow-right" style="solid" class="text-xs" />
              </span>
              <span class="mt-2 block font-semibold text-violet-100 group-hover:text-white">
                {newer.title}
              </span>
            </a>
          )
        }
      </nav>

      <p class="mt-8 text-center">
        <a
          href="/newsletters"
          class="inline-flex items-center gap-2 text-base font-semibold text-amber-400 hover:text-amber-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-400"
        >
          All newsletters
          <Icon name="arrow-right" style="solid" class="text-sm" />
        </a>
      </p>
    </article>
  </Container>
</Template>
