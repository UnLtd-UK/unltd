---
import Template from "@layouts/Template.astro";
import Container from "@components/Container.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import PortableContent from "@components/emdash/PortableContent.astro";
import SegmentBadges from "@components/newsletters/SegmentBadges.astro";

import { getAllNewsletters, getNewsletter } from "@lib/newsletters-runtime";
import { CMS_PAGE_CACHE } from "@lib/route-cache";
import { formatLongDateTime } from "@utils/post-format";

// Rendered on demand so a new or edited newsletter, and an EmDash draft
// preview, show without a rebuild. Route caching keeps it fast: EmDash tags
// each response, and publishing purges it.
export const prerender = false;

const slug = Astro.params.newsletter;
if (!slug) return Astro.rewrite("/404");

const [{ newsletter, isPreview, cacheHint }, { newsletters, cacheHints }] =
  await Promise.all([getNewsletter(slug), getAllNewsletters()]);
if (!newsletter) return Astro.rewrite("/404");

if (Astro.cache?.enabled) {
  // A draft preview or an editor's edit-mode view is for one person, not for the shared cache.
  const editing = Astro.cookies.get("emdash-edit-mode")?.value === "true";
  if (isPreview || editing) Astro.cache.set(false);
  else {
    // The neighbouring editions are linked at the bottom, so they are tagged too.
    [cacheHint, ...cacheHints].forEach((hint) => Astro.cache.set(hint));
    Astro.cache.set(CMS_PAGE_CACHE);
  }
}

const { title, subtitle, content, date, segments, edit } = newsletter;

// The list is newest first, so the edition before this one is the next in the list.
const index = newsletters.findIndex((item) => item.slug === newsletter.slug);
const newer = index > 0 ? newsletters[index - 1] : null;
const older = index >= 0 ? (newsletters[index + 1] ?? null) : null;

const breadcrumbs = [
  { name: "Newsletters", path: "/newsletters" },
  { name: title, path: `/newsletters/${newsletter.slug}` },
];
---

<Template name={title} description={subtitle}>
  <Container>
    <Breadcrumbs breadcrumbs={breadcrumbs} />

    <article class="grid gap-10 py-10 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-16 lg:py-14">
      <header class="flex flex-col gap-6 lg:sticky lg:top-6 lg:self-start">
        <div class="flex flex-col gap-5">
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-violet-400">Subject</p>
            <h1 class="mt-1 text-2xl font-semibold leading-tight text-violet-100" {...edit.title}>
              {title}
            </h1>
          </div>
          {
            subtitle && (
              <div>
                <p class="text-xs font-medium uppercase tracking-wide text-violet-400">Preview text</p>
                <p class="mt-1 text-sm leading-6 text-violet-300" {...edit.subtitle}>
                  {subtitle}
                </p>
              </div>
            )
          }
        </div>

        <dl class="divide-y divide-violet-800 border-y border-violet-800 text-sm">
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-violet-400">Sent</dt>
            <dd class="text-violet-100">
              <time datetime={date}>{formatLongDateTime(date)}</time>
            </dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-violet-400">Segment</dt>
            <dd>
              <SegmentBadges segments={segments} />
            </dd>
          </div>
        </dl>

        <a
          href="/newsletters"
          class="text-sm font-medium text-violet-300 underline underline-offset-4 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-400"
        >
          All newsletters
        </a>
      </header>

      <div class="min-w-0">
        <PortableContent value={content} />

        <nav
          aria-label="More newsletters"
          class="mt-12 flex flex-wrap justify-between gap-4 border-t border-violet-800 pt-6 text-sm"
        >
          {
            older ? (
              <a
                href={`/newsletters/${older.slug}`}
                class="text-violet-300 hover:text-white"
              >
                <span class="block text-violet-400">Previous</span>
                <span class="font-semibold">{older.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            newer && (
              <a
                href={`/newsletters/${newer.slug}`}
                class="text-right text-violet-300 hover:text-white"
              >
                <span class="block text-violet-400">Next</span>
                <span class="font-semibold">{newer.title}</span>
              </a>
            )
          }
        </nav>
      </div>
    </article>
  </Container>
</Template>
