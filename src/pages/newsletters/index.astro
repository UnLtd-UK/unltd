---
import Template from "@layouts/Template.astro";
import Container from "@components/Container.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Default from "@components/heroes/Default.astro";
import Icon from "@components/Icon.astro";

import { getAllNewsletters } from "@lib/newsletters-runtime";
import { CMS_PAGE_CACHE } from "@lib/route-cache";
import { formatLongDate, formatShortDate, postYear } from "@utils/post-format";

// Rendered on demand so a newly published newsletter shows without a rebuild.
// Route caching keeps it fast: EmDash tags the response, and publishing purges it.
export const prerender = false;

const title = "Newsletters";
const description =
  "Catch up on past editions of our newsletter, and read them on the web.";

const breadcrumbs = [{ name: title, path: "/newsletters" }];

const { newsletters, cacheHints } = await getAllNewsletters();
if (Astro.cache?.enabled) {
  cacheHints.forEach((hint) => Astro.cache.set(hint));
  Astro.cache.set(CMS_PAGE_CACHE);
}

const [latest, ...earlier] = newsletters;

// Newest first, so each year's group and the years themselves are in order.
const byYear = new Map<number, typeof earlier>();
for (const newsletter of earlier) {
  const year = postYear(newsletter.date);
  byYear.set(year, [...(byYear.get(year) ?? []), newsletter]);
}
---

<Template name={title} description={description}>
  <Container>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
    <Default name={title} description={description} />

    <div class="pb-20 space-y-14">
      {
        !latest && (
          <p class="rounded-2xl bg-violet-900/30 p-6 text-violet-300 ring-1 ring-violet-600/30">
            There are no newsletters to read yet. Check back soon.
          </p>
        )
      }

      {
        latest && (
          <section aria-labelledby="latest-heading">
            <p
              id="latest-heading"
              class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-amber-400"
            >
              Latest edition
            </p>
            <a
              href={`/newsletters/${latest.slug}`}
              class="group block rounded-2xl bg-linear-to-br from-violet-900 to-violet-950 p-8 ring-1 ring-violet-600/40 transition-all duration-300 hover:-translate-y-0.5 hover:ring-violet-400/60 hover:shadow-xl hover:shadow-violet-500/10 sm:p-10"
            >
              <time
                datetime={latest.date}
                class="text-sm font-medium text-violet-300"
              >
                {formatLongDate(latest.date)}
              </time>
              <h2 class="mt-3 text-3xl font-bold tracking-tight text-violet-100 group-hover:text-white sm:text-4xl">
                {latest.title}
              </h2>
              {latest.subtitle && (
                <p class="mt-4 max-w-2xl text-lg leading-8 text-violet-300">
                  {latest.subtitle}
                </p>
              )}
              <span class="mt-6 inline-flex items-center gap-2 text-base font-semibold text-amber-400 group-hover:text-amber-300">
                Read this edition
                <Icon name="arrow-right" style="solid" class="text-sm" />
              </span>
            </a>
          </section>
        )
      }

      {
        [...byYear].map(([year, issues]) => (
          <section aria-labelledby={`year-${year}`}>
            <h2
              id={`year-${year}`}
              class="border-b border-violet-800 pb-3 text-sm font-semibold uppercase tracking-[0.2em] text-violet-400"
            >
              {year}
            </h2>
            <ul class="divide-y divide-violet-800/70">
              {issues.map((newsletter) => (
                <li>
                  <a
                    href={`/newsletters/${newsletter.slug}`}
                    class="group flex flex-col gap-1 py-5 transition-colors sm:flex-row sm:items-baseline sm:gap-8"
                  >
                    <time
                      datetime={newsletter.date}
                      class="w-28 shrink-0 text-sm text-violet-400"
                    >
                      {formatShortDate(newsletter.date)}
                    </time>
                    <span class="flex-1">
                      <span class="block text-lg font-semibold text-violet-100 group-hover:text-white">
                        {newsletter.title}
                      </span>
                      {newsletter.subtitle && (
                        <span class="mt-1 block text-sm leading-relaxed text-violet-300/80 line-clamp-2">
                          {newsletter.subtitle}
                        </span>
                      )}
                    </span>
                    <Icon
                      name="arrow-right"
                      style="solid"
                      class="hidden text-sm text-violet-500 transition-transform group-hover:translate-x-1 group-hover:text-amber-400 sm:block"
                    />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </Container>
</Template>
