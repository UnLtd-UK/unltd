---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Container from "@components/Container.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import Template from "@layouts/Template.astro";

const name = "Unsubscribe from the newsletter";
const description =
    "Verify your email address to unsubscribe from the UnLtd newsletter.";
---

<Template name={name} description={description} noindex>
    <Container>
        <Breadcrumbs
            breadcrumbs={[
                { name: "UnLtd Newsletter", path: "/newsletter" },
                { name, path: "/newsletter/unsubscribe" },
            ]}
        />
    </Container>
    <div class="px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
        <div class="mx-auto max-w-xl">
            <h1
                class="text-4xl font-bold tracking-tight text-violet-200 sm:text-5xl"
                id="unsubscribe-heading"
                tabindex="-1"
            >
                {name}
            </h1>

            <!-- Step 1: ask for the email address, then we send a verification link -->
            <div id="unsubscribe-request" class="mt-6">
                <p class="text-base text-violet-300">
                    Enter the email address you subscribed with. We'll send a
                    link to confirm it's you before we unsubscribe it.
                </p>
                <div class="mt-6">
                    <NewsletterSignup mode="unsubscribe" id="newsletter-unsubscribe" />
                </div>
            </div>

            <!-- Step 2: arrived from the verification email -->
            <div id="unsubscribe-confirm" class="mt-6" hidden>
                <p class="text-base text-violet-300">
                    Press the button below to stop receiving the UnLtd
                    newsletter.
                </p>
                <button
                    type="button"
                    id="unsubscribe-button"
                    class="mt-6 rounded-full bg-violet-600 px-5 py-2 text-sm font-semibold text-white hover:bg-violet-700 focus:outline-hidden focus:ring-2 focus:ring-violet-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60"
                >
                    Unsubscribe
                </button>
            </div>

            <p
                class="mt-4 text-base text-violet-300"
                role="status"
                aria-live="polite"
                id="unsubscribe-message"
            >
            </p>
            <p class="mt-6 text-sm text-violet-300" id="unsubscribe-resubscribe" hidden>
                Changed your mind? <a
                    href="/newsletter"
                    class="underline hover:text-violet-100">Subscribe again</a
                >.
            </p>
            <p class="mt-8 text-sm text-violet-300">
                You can also unsubscribe at any time using the link at the
                bottom of every newsletter email.
            </p>
        </div>
    </div>
</Template>

<script>
    // The inline analytics snippet strips the token from the URL before this
    // script runs, so read it from the values it captured.
    const token =
        (window as unknown as { __redactedQueryParams?: Record<string, string> })
            .__redactedQueryParams?.token ??
        new URLSearchParams(location.search).get("token");
    const heading = document.getElementById("unsubscribe-heading")!;
    const requestStep = document.getElementById("unsubscribe-request")!;
    const confirmStep = document.getElementById("unsubscribe-confirm")!;
    const button = document.getElementById(
        "unsubscribe-button",
    ) as HTMLButtonElement;
    const message = document.getElementById("unsubscribe-message")!;
    const resubscribe = document.getElementById("unsubscribe-resubscribe")!;

    if (token) {
        // The token is removed from the address bar once read.
        history.replaceState(null, "", location.pathname);
        requestStep.hidden = true;
        confirmStep.hidden = false;

        const finish = (title: string, text: string, resub = false) => {
            heading.textContent = title;
            heading.focus();
            confirmStep.hidden = true;
            message.textContent = text;
            resubscribe.hidden = !resub;
        };

        button.addEventListener("click", async () => {
            button.disabled = true;
            message.textContent = "Unsubscribing…";
            try {
                const response = await fetch("/api/newsletter/unsubscribe", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ token }),
                });
                const result = await response.json().catch(() => ({}));
                if (response.ok) {
                    finish(
                        "You've been unsubscribed",
                        "You won't receive any more newsletters from us.",
                        true,
                    );
                } else if (result.error === "expired") {
                    finish(
                        "Link expired",
                        "This link has expired. You can request a new one below.",
                    );
                    requestStep.hidden = false;
                } else if (result.error === "invalid") {
                    finish(
                        "Link not valid",
                        "This unsubscribe link isn't valid. You can request a new one below.",
                    );
                    requestStep.hidden = false;
                } else {
                    throw new Error("server");
                }
            } catch {
                button.disabled = false;
                message.textContent =
                    "Something went wrong. Please try again.";
            }
        });
    }
</script>
