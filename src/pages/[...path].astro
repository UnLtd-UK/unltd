---
// Every page is prerendered, so a path with no page matches no route and would
// bypass middleware. This catch-all gives those paths a route, so EmDash's
// redirect middleware (Admin > Redirects) runs first; if no redirect applies it
// serves the prerendered 404 page.
import { env } from "cloudflare:workers";

export const prerender = false;

const page = await env.ASSETS.fetch(new URL("/404", Astro.url));
return new Response(page.body, {
  status: 404,
  headers: { "content-type": "text/html; charset=utf-8" },
});
---
