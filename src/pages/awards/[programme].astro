---
import Template from "@layouts/Template.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Container from "@components/Container.astro";
import { palette } from "@data/palette.js";
import Intro from "@components/awards/programme/Intro.astro";
import Content from "@components/awards/programme/Content.astro";
import Services from "@components/awards/programme/Services.astro";

import { programmes } from "@data/programmes.ts";
import type { ProgrammeEntry } from "@data/programmes.ts";

export async function getStaticPaths() {
  return programmes.map((programme) => ({
    params: { programme: programme.slug },
    props: {
      programme,
      breadcrumbs: [
        { name: "Awards", path: "/awards" },
        { name: programme.title, path: `/awards/${programme.slug}` },
      ],
    },
  }));
}

const { programme, breadcrumbs } = Astro.props as {
  programme: ProgrammeEntry;
  breadcrumbs: { name: string; path: string }[];
};

// Fall back to the default UnLtd theme when a programme doesn't have a
// dedicated palette entry yet (e.g. newly added programmes awaiting a
// finalised colour), so the build doesn't crash on missing palette data.
const theme = palette[programme.title] ?? palette["UnLtd"];

const description =
  programme.summary.length > 160
    ? `${programme.summary.slice(0, 157).trimEnd()}...`
    : programme.summary;
---

<Template
  name={programme.title}
  description={description}
  theme={theme}
>
  <Container bg={theme.bg}>
    <Breadcrumbs breadcrumbs={breadcrumbs} styles={theme} />
  </Container>

  <Intro programme={programme} styles={theme} />

  {
    programme.services.length > 0 && (
      <Services styles={theme} services={programme.services} />
    )
  }

  {
    (programme.videos.length > 0 || programme.content.length > 0) && (
      <Content styles={theme} programme={programme} />
    )
  }
</Template>
