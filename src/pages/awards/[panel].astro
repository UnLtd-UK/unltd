---
import type { GetStaticPaths } from "astro";
import Template from "@layouts/Template.astro";
import Container from "@components/Container.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import PersonCard from "@components/PersonCard.astro";
import moment from "moment";

import { panels, type PanelEntry } from "@data/panels";

type PanelPageProps = {
    panel: PanelEntry;
    breadcrumbs: { name: string; path: string }[];
};

export const getStaticPaths = (() => {
    return panels.map((panel) => ({
        params: { panel: panel.slug },
        props: {
            panel,
            breadcrumbs: [
                { name: "Awards", path: "/awards" },
                { name: panel.slug, path: `/awards/${panel.slug}` },
            ],
        },
    }));
}) satisfies GetStaticPaths;

const { panel, breadcrumbs }: PanelPageProps = Astro.props;

const name = moment(panel.date).format("DD-MM-YYYY");
const date = moment(panel.date).format("dddd, MMMM Do YYYY");
const description =
    "Hello! We are your panel members; we are looking forward to meeting you and hearing about your social venture.";

const toProfile = (person: PanelEntry["colleagues"][number]) => ({
    name: person.name,
    pronouns: person.pronouns ? [person.pronouns] : [],
    roleName: person.roleTitle,
    subtitle: person.subtitle,
    avatarSrc: person.image || null,
    imageAlt: person.imageAlt,
    linkedin: person.linkedin || null,
});

const chair = panel.chair ? toProfile(panel.chair) : null;
const colleagues = panel.colleagues.map(toProfile);

const guests = panel.members.map((member) => ({
    name: member.name,
    pronouns: member.pronouns ? [member.pronouns] : [],
    roleName: member.jobTitle,
    subtitle: member.subtitle,
    avatarSrc: member.image || null,
    imageAlt: "",
    linkedin: null,
}));
---

<Template
    name={name}
    breadcrumbs={breadcrumbs}
    description={description}
    noindex={true}
    hideFloatingBanner={true}
>
    <Container>
        <Breadcrumbs breadcrumbs={breadcrumbs} />
        <div class="py-12">
            <div class="grid grid-cols-1 gap-x-10 gap-y-20 xl:grid-cols-5">
                <div class="max-w-2xl xl:col-span-2 xl:sticky xl:top-8 xl:self-start flex flex-col gap-6">
                    <div class="flex flex-col gap-4">
                        <h2 class="text-4xl font-bold tracking-tight text-violet-100">
                            Your Award Panel
                        </h2>
                        <p class="text-lg leading-8 text-violet-300">
                            Hello! We are your panel members; we are looking
                            forward to meeting you and hearing about your social
                            venture.
                        </p>
                    </div>
                    <dl class="divide-y divide-violet-700 rounded-2xl bg-violet-900 px-6 py-2 ring-1 ring-violet-700">
                        <div class="py-4">
                            <dt class="text-xs font-medium uppercase tracking-wide text-violet-300">
                                Date
                            </dt>
                            <dd class="mt-1 text-xl font-bold tracking-tight text-violet-100">
                                {date}
                            </dd>
                        </div>
                        <div class="py-4">
                            <dt class="text-xs font-medium uppercase tracking-wide text-violet-300">
                                Award programme
                            </dt>
                            <dd class="mt-1 text-xl font-bold tracking-tight text-violet-100">
                                {panel.programme}
                            </dd>
                        </div>
                        {chair && (
                            <div class="py-4">
                                <dt class="mb-3 text-xs font-medium uppercase tracking-wide text-violet-300">
                                    UnLtd panel chair
                                </dt>
                                <dd>
                                    <PersonCard person={chair} showSubtitle />
                                </dd>
                            </div>
                        )}
                        {colleagues.length > 0 && (
                            <div class="py-4">
                                <dt class="mb-3 text-xs font-medium uppercase tracking-wide text-violet-300">
                                    UnLtd panel members
                                </dt>
                                <dd>
                                    <ul class="flex flex-col gap-y-6">
                                        {colleagues.map((person) => (
                                            <li>
                                                <PersonCard person={person} showSubtitle />
                                            </li>
                                        ))}
                                    </ul>
                                </dd>
                            </div>
                        )}
                    </dl>
                    <p class="text-xs leading-5 text-violet-300">
                        UnLtd panels reflect our commitment to inclusion, with
                        over 50% of our panel members identifying as Black,
                        Asian or minority ethnic and/or disabled, and at a
                        minimum, one panel member who identifies as Black, Asian
                        or minority ethnic and/or disabled sitting on each
                        panel.
                    </p>
                </div>
                <div class="xl:col-span-3">
                    <h3 class="mb-6 text-xs font-medium uppercase tracking-wide text-violet-300">
                        Social entrepreneur panel members
                    </h3>
                    <ul class="flex flex-col gap-y-10">
                        {guests.map((person) => (
                            <li>
                                <PersonCard person={person} showSubtitle subtitleOpen />
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </Container>

    <script is:inline>
        const searchParams = new URLSearchParams(window.location.search);
        let name = searchParams.get("name");
        const nameElement = document.getElementById("dos");

        name = name.replace("%20", " ").trim();

        const regex = /^[a-zA-Z ]+$/;

        if (regex.test(name)) nameElement.textContent = name;
    </script>
</Template>
