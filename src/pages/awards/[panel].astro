---
import type { GetStaticPaths } from "astro";
import Template from "@layouts/Template.astro";
import Container from "@components/Container.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import PersonCard from "@components/PersonCard.astro";
import moment from "moment";

import { panels, type PanelEntry } from "@data/panels";

type PanelPageProps = {
    panel: PanelEntry;
    breadcrumbs: { name: string; path: string }[];
};

export const getStaticPaths = (() => {
    return panels.map((panel) => ({
        params: { panel: panel.slug },
        props: {
            panel,
            breadcrumbs: [
                { name: "Awards", path: "/awards" },
                { name: panel.slug, path: `/awards/${panel.slug}` },
            ],
        },
    }));
}) satisfies GetStaticPaths;

const { panel, breadcrumbs }: PanelPageProps = Astro.props;

const name = moment(panel.date).format("DD-MM-YYYY");
const date = moment(panel.date).format("dddd, MMMM Do YYYY");
const description =
    "Hello! We are your panel members; we are looking forward to meeting you and hearing about your social venture.";

const toProfile = (person: PanelEntry["colleagues"][number]) => ({
    name: person.name,
    pronouns: person.pronouns ? [person.pronouns] : [],
    roleName: person.roleTitle,
    subtitle: person.subtitle,
    avatarSrc: person.image || null,
    imageAlt: person.imageAlt,
    linkedin: person.linkedin || null,
});

const people = [
    ...(panel.chair
        ? [{ ...toProfile(panel.chair), badge: "Panel Chair" }]
        : []),
    ...panel.members.map((member) => ({
        name: member.name,
        pronouns: member.pronouns ? [member.pronouns] : [],
        roleName: member.jobTitle,
        avatarSrc: member.image || null,
        imageAlt: "",
        linkedin: null,
    })),
    ...panel.colleagues.map(toProfile),
];
---

<Template
    name={name}
    breadcrumbs={breadcrumbs}
    description={description}
    noindex={true}
>
    <Container>
        <Breadcrumbs breadcrumbs={breadcrumbs} />
        <div class="py-12">
            <div class="grid grid-cols-1 gap-x-10 gap-y-20 xl:grid-cols-5">
                <div class="max-w-2xl xl:col-span-2 flex flex-col gap-3">
                    <div>
                        <h2 class="text-3xl font-bold tracking-tight text-violet-100">
                            Your Award Panel
                        </h2>
                    </div>
                    <div>
                        <h3 class="text-base tracking-tight text-violet-300">
                            Date
                        </h3>
                        <p class="text-xl font-bold tracking-tight text-violet-200">
                            {date}
                        </p>
                    </div>
                    <div>
                        <h3 class="text-base tracking-tight text-violet-300">
                            Award programme
                        </h3>
                        <p class="text-xl font-bold tracking-tight text-violet-200">
                            {panel.programme}
                        </p>
                    </div>
                    <p class="mt-6 text-lg leading-8 text-violet-300">
                        Hello! We are your panel members; we are looking forward
                        to meeting you and hearing about your social venture.
                    </p>
                    <p class="mt-6 text-xs leading-5 text-violet-300">
                        UnLtd panels reflect our commitment to inclusion, with
                        over 50% of our panel members identifying as Black,
                        Asian or minority ethnic and/or disabled, and at a
                        minimum, one panel member who identifies as Black, Asian
                        or minority ethnic and/or disabled sitting on each
                        panel.
                    </p>
                </div>
                <div class="xl:col-span-3">
                    <ul class="flex flex-col gap-y-10">
                        {people.map((person) => (
                            <li>
                                <PersonCard person={person} />
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </Container>

    <script is:inline>
        const searchParams = new URLSearchParams(window.location.search);
        let name = searchParams.get("name");
        const nameElement = document.getElementById("dos");

        name = name.replace("%20", " ").trim();

        const regex = /^[a-zA-Z ]+$/;

        if (regex.test(name)) nameElement.textContent = name;
    </script>
</Template>
