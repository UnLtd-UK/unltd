---
import Template from "@layouts/Template.astro";
import Container from "@components/Container.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Default from "@components/heroes/Default.astro";
import Content from "@components/markdoc/Content.astro";

import { marked } from "marked";

import { pages } from "@data/pages.js";

export async function getStaticPaths() {
  return pages.map((page) => {
    // Use the slug field from Directus
    const pageSlug = page.slug;

    let breadcrumbs = [
      {
        name: page.name,
        path: `/${pageSlug}`,
      },
    ];

    page.breadcrumbs = breadcrumbs;

    let item = {
      params: {
        page: pageSlug,
      },
      props: {
        ...page,
      },
    };

    return item;
  });
}

const { name, description, body, breadcrumbs, last_updated, date_updated } =
  Astro.props;

const lastUpdatedText =
  last_updated && date_updated
    ? `${new Date(date_updated).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })} at ${new Date(date_updated).toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" })}`
    : null;
---

<Template name={name} description={description}>
  <Container>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
    <Default name={name} description={description} />
    {
      lastUpdatedText && (
        <p class="text-sm text-violet-300 -mt-4 mb-6">
          Last updated: {lastUpdatedText}
        </p>
      )
    }
    <div class="pb-20">
      <Content body={body} />
    </div>
  </Container>
</Template>
