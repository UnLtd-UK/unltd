---
import Template from "@layouts/Template.astro";
import Container from "@components/Container.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Default from "@components/heroes/Default.astro";
import PortableContent from "@components/emdash/PortableContent.astro";
import { getPage } from "@lib/pages-runtime";
import { CMS_PAGE_CACHE } from "@lib/route-cache";

// Rendered on demand so a new or edited page, and an EmDash draft preview,
// show without a rebuild. Route caching keeps it fast: EmDash tags each
// response, and publishing purges it. Pages with their own file in src/pages
// (awards, contact, ...) take priority over this route.
export const prerender = false;

const slug = Astro.params.page;
if (!slug) return Astro.rewrite("/404");

const { page, isPreview, cacheHint } = await getPage(slug);
if (!page) return Astro.rewrite("/404");

if (Astro.cache?.enabled) {
  // A draft preview is for one editor, not for the shared cache.
  if (isPreview) Astro.cache.set(false);
  else {
    Astro.cache.set(cacheHint);
    Astro.cache.set(CMS_PAGE_CACHE);
  }
}

const { title, subtitle, content, showUpdatedAt, updatedAt } = page;
const breadcrumbs = [{ name: title, path: `/${page.slug}` }];

const dateOptions = { timeZone: "Europe/London" } as const;
const lastUpdatedText =
  showUpdatedAt && updatedAt
    ? `${new Date(updatedAt).toLocaleDateString("en-GB", { ...dateOptions, day: "numeric", month: "long", year: "numeric" })} at ${new Date(updatedAt).toLocaleTimeString("en-GB", { ...dateOptions, hour: "2-digit", minute: "2-digit" })}`
    : null;
---

<Template name={title} description={subtitle}>
  <Container>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
    <Default name={title} description={subtitle} />
    {
      lastUpdatedText && (
        <p class="text-sm text-violet-300 -mt-4 mb-6">
          Last updated: {lastUpdatedText}
        </p>
      )
    }
    <div class="pb-20">
      <PortableContent value={content} />
    </div>
  </Container>
</Template>
