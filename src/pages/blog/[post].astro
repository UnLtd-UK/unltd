---
import Template from "@layouts/Template.astro";
import Container from "@components/Container.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import HeroPost from "@components/heroes/Post.astro";
import PortableContent from "@components/emdash/PortableContent.astro";

import { posts } from "@data/posts.ts";
import type { PostEntry } from "@data/posts.ts";

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { post: post.slug },
    props: {
      post,
      breadcrumbs: [
        { name: "Blog", path: "/blog" },
        { name: post.title, path: `/blog/${post.slug}` },
      ],
    },
  }));
}

const { post, breadcrumbs } = Astro.props as {
  post: PostEntry;
  breadcrumbs: Array<{ name: string; path: string }>;
};
---

<Template name={post.title} description={post.subtitle}>
  <Container>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
    <HeroPost post={post} />
    <div class="py-12">
      <PortableContent value={post.content} />
    </div>
  </Container>
</Template>
