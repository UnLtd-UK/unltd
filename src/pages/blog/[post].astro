---
import Template from "@layouts/Template.astro";
import Container from "@components/Container.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import HeroPost from "@components/heroes/Post.astro";
import PortableContent from "@components/emdash/PortableContent.astro";
import BlogIndex from "@components/BlogIndex.astro";
import { getAllPosts, getPost, postYears } from "@lib/posts-runtime";
import { postYear } from "@utils/post-format";
import type { PostEntry } from "@data/posts";

// Rendered on demand so a new or edited post, and an EmDash draft preview,
// show without a rebuild. Route caching keeps it fast: EmDash tags each
// response, and publishing purges it.
export const prerender = false;

const slug = Astro.params.post;
if (!slug) return Astro.rewrite("/404");

// /blog/2025 matches this route too, so it lists that year's posts.
let listing: { year: number; years: number[]; posts: PostEntry[] } | null = null;
if (/^\d{4}$/.test(slug)) {
  const year = Number(slug);
  const { posts, cacheHints } = await getAllPosts();
  const years = postYears(posts);
  if (!years.includes(year)) return Astro.rewrite("/404");
  if (Astro.cache?.enabled) cacheHints.forEach((hint) => Astro.cache.set(hint));
  listing = { year, years, posts: posts.filter((post) => postYear(post.date) === year) };
}

const result = listing ? null : await getPost(slug);
if (!listing && !result?.post) return Astro.rewrite("/404");

if (result && Astro.cache?.enabled) {
  // A draft preview is for one editor, not for the shared cache.
  if (result.isPreview) Astro.cache.set(false);
  else Astro.cache.set(result.cacheHint);
}

const post = result?.post;
const breadcrumbs = post
  ? [
      { name: "Blog", path: "/blog" },
      { name: post.title, path: `/blog/${post.slug}` },
    ]
  : [];
---

{
  listing ? (
    <BlogIndex posts={listing.posts} years={listing.years} year={listing.year} />
  ) : (
    post && (
      <Template name={post.title} description={post.subtitle}>
        <Container>
          <Breadcrumbs breadcrumbs={breadcrumbs} />
          <HeroPost post={post} />
          <div class="py-12">
            <PortableContent value={post.content} />
          </div>
        </Container>
      </Template>
    )
  )
}
