---
import Template from "@layouts/Template.astro";
import Container from "@components/Container.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Default from "@components/heroes/Default.astro";
import PortableContent from "@components/emdash/PortableContent.astro";
import TableOfContents from "@components/TableOfContents.astro";

import { getResource } from "@lib/resources-runtime";
import { headingsToToc } from "@data/functions/portableHeadings";
import { CMS_PAGE_CACHE } from "@lib/route-cache";

// Rendered on demand so a new or edited resource, and an EmDash draft preview,
// show without a rebuild. Route caching keeps it fast: EmDash tags each
// response, and publishing purges it.
export const prerender = false;

const slug = Astro.params.resource;
if (!slug) return Astro.rewrite("/404");

const { resource, isPreview, cacheHint } = await getResource(slug);
if (!resource) return Astro.rewrite("/404");

if (Astro.cache?.enabled) {
  // A draft preview or an editor's edit-mode view is for one person, not for the shared cache.
  const editing = Astro.cookies.get("emdash-edit-mode")?.value === "true";
  if (isPreview || editing) Astro.cache.set(false);
  else {
    Astro.cache.set(cacheHint);
    Astro.cache.set(CMS_PAGE_CACHE);
  }
}

const { title, subtitle, content, hidden, edit } = resource;
const toc = headingsToToc(content);
const breadcrumbs = [
  { name: "Resources", path: "/resources" },
  { name: title, path: `/resources/${resource.slug}` },
];
---

<Template name={title} description={subtitle} noindex={hidden}>
  <Container>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
    <Default name={title} description={subtitle} nameAttrs={edit.title} descriptionAttrs={edit.subtitle} />
    <div class="flex gap-8 lg:gap-12 pb-16 items-start">
      {
        toc.length > 0 && (
          <aside class="hidden lg:block sticky top-24">
            <TableOfContents headings={toc} variant="desktop" />
          </aside>
        )
      }
      <article class="flex-1 min-w-0">
        <div
          class="bg-violet-900/30 rounded-2xl ring-1 ring-violet-700/50 p-6 sm:p-8 lg:p-10"
        >
          <PortableContent value={content} />
        </div>
      </article>
    </div>
  </Container>
</Template>
