---
import Template from "@layouts/Template.astro";
import Container from "@components/Container.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import ResourcesLayout from "@components/resources/ResourcesLayout.astro";
import ResourceHeader from "@components/resources/ResourceHeader.astro";
import ResourceCard from "@components/resources/ResourceCard.astro";
import ResourceEvents from "@components/resources/ResourceEvents.astro";

import { getResourceGroups } from "@lib/resources-runtime";
import { loadProgrammeEvents } from "@lib/site-shell";
import { isPastEvent, sortEvents } from "@lib/event-helpers";
import { CMS_PAGE_CACHE } from "@lib/route-cache";

// Rendered on demand so a new or edited resource shows without a rebuild.
// Route caching keeps it fast: EmDash tags the response, and publishing purges
// it. The upcoming events come from the build (Eventbrite), as before.
export const prerender = false;

const title = "Getting started";
const description =
  "Guides and information to help you apply for an UnLtd award. Choose a topic to get started.";

const breadcrumbs = [{ name: "Resources", path: "/resources" }];

const [{ groups, cacheHints }, programmeEvents] = await Promise.all([
  getResourceGroups(),
  loadProgrammeEvents(Astro),
]);
if (Astro.cache?.enabled) {
  cacheHints.forEach((hint) => Astro.cache.set(hint));
  Astro.cache.set(CMS_PAGE_CACHE);
}

const events = sortEvents(programmeEvents.filter((e) => !isPastEvent(e)));
---

<Template name={title} description={description}>
  <Container>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
    <ResourcesLayout groups={groups} aside={events.length > 0}>
      <ResourceHeader title={title} subtitle={description} />

      <ul class="grid gap-4 sm:grid-cols-2">
        {
          groups.map((group) => (
            <li>
              <ResourceCard
                href={group.resources[0].href}
                title={group.title}
                icon={group.icon}
                subtitle={group.subtitle}
                meta={`${group.resources.length} ${group.resources.length === 1 ? "page" : "pages"}`}
                metaIcon="book-open"
              />
            </li>
          ))
        }
      </ul>

      <div class="mt-14 border-t border-violet-800 pt-8 xl:hidden">
        <ResourceEvents events={events} />
      </div>

      <Fragment slot="aside">
        <ResourceEvents events={events} />
      </Fragment>
    </ResourcesLayout>
  </Container>
</Template>
