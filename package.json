{
  "name": "unltd",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && npx wrangler deploy --config wrangler.jsonc --dry-run",
    "build:test": "npm run build && npm run test",
    "preview": "astro preview",
    "astro": "astro",
    "clear": "rimraf ./src/data/cache/*.json",
    "update": "npx npm-check-updates -u -x typescript,typescript-eslint-ts6 && npm install",
    "deploy:prod": "astro build && wrangler deploy --config wrangler.jsonc --env production",
    "migrate:ghost": "node scripts/migrate-to-ghost.js",
    "migrate:posts": "node scripts/migrate-posts-to-emdash.mjs",
    "test": "npm run lint:a11y && npm run test:a11y",
    "test:a11y": "start-server-and-test preview http://localhost:4321 test:a11y:scan",
    "test:a11y:scan": "pa11y-ci --config .pa11yci.json --sitemap http://localhost:4321/sitemap-index.xml --sitemap-find https://unltd.org.uk --sitemap-replace http://localhost:4321",
    "lint:a11y": "node scripts/link-eslint-typescript.cjs && eslint . --ext .astro,.jsx,.tsx"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^1.0.0",
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/markdoc": "^2.1.2",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@awesome.me/kit-0ff725f684": "^1.0.22",
    "@daviddarnes/storage-form": "^2.0.1",
    "@directus/sdk": "^27.1.0",
    "@emdash-cms/cloudflare": "^1.4.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "^2.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/alpinejs": "^3.17.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "alpinejs": "^3.17.5",
    "astro": "^7.4.4",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emdash": "^1.4.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.65.0",
    "maplibre-gl": "^6.16.0",
    "marked": "^18.1.2",
    "marked-gfm-heading-id": "^4.1.4",
    "micromodal": "^0.7.0",
    "moment": "^2.31.0",
    "octokit": "^5.0.5",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.444.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "resend": "^6.36.0",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "truncate": "^3.0.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.9",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/parser": "^8.72.1",
    "astro-eslint-parser": "^3.2.0",
    "baseline-browser-mapping": "^2.11.34",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "pa11y-ci": "^5.0.0",
    "prettier-plugin-astro": "^1.1.2",
    "rimraf": "^6.1.3",
    "start-server-and-test": "^3.0.13",
    "typescript-eslint-ts6": "npm:typescript@^6",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "vite": "^8",
    "sharp": "^0.35.4"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true,
    "core-js@3.50.0": false,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.4": true,
    "esbuild@0.28.1": true,
    "puppeteer@24.43.1": true,
    "workerd@1.20260820.1": true,
    "workerd@1.20260908.1": true
  }
}
