{
  "name": "unltd",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && wrangler deploy --config wrangler.jsonc --dry-run",
    "build:test": "pnpm run build && pnpm run test",
    "preview": "astro preview",
    "astro": "astro",
    "update": "pnpm dlx npm-check-updates -u -x typescript && pnpm install",
    "deploy:prod": "astro build && wrangler deploy --config wrangler.jsonc --env production",
    "test": "pnpm run lint:a11y && pnpm run test:a11y",
    "test:a11y": "start-server-and-test preview http://localhost:4321 test:a11y:scan",
    "test:a11y:scan": "pa11y-ci --config .pa11yci.json --sitemap http://localhost:4321/sitemap-index.xml --sitemap-find https://unltd.org.uk --sitemap-replace http://localhost:4321",
    "lint:a11y": "eslint . --ext .astro,.jsx,.tsx"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^1.0.0",
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/mdx": "^8.1.4",
    "@astrojs/react": "^7.1.7",
    "@astrojs/sitemap": "^3.7.4",
    "@awesome.me/kit-0ff725f684": "^1.0.22",
    "@daviddarnes/storage-form": "^2.0.1",
    "@emdash-cms/cloudflare": "^1.4.0",
    "@emdash-cms/plugin-forms": "^0.2.12",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "^2.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/alpinejs": "^3.17.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "alpinejs": "^3.17.5",
    "astro": "^7.4.10",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emdash": "^1.4.0",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.72.0",
    "maplibre-gl": "^6.17.0",
    "marked": "^18.2.0",
    "marked-gfm-heading-id": "^4.1.4",
    "micromodal": "^0.7.0",
    "moment": "^2.31.0",
    "octokit": "^5.0.5",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.447.12",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "resend": "^6.38.0",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "truncate": "^3.0.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.12",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/parser": "^8.72.2",
    "astro-eslint-parser": "^3.2.0",
    "baseline-browser-mapping": "^2.11.35",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "pa11y-ci": "^5.0.0",
    "prettier-plugin-astro": "^1.1.2",
    "rimraf": "^6.1.4",
    "start-server-and-test": "^3.0.13",
    "wrangler": "^4.160.0"
  },
  "packageManager": "pnpm@12.16.1"
}
