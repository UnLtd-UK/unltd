{
  "name": "unltd",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && npx wrangler deploy --config wrangler.jsonc --dry-run",
    "build:test": "npm run build && npm run test",
    "preview": "astro preview",
    "astro": "astro",
    "clear": "rimraf ./src/data/cache/*.json",
    "update": "npx npm-check-updates -u -x typescript && npm install",
    "deploy:draft": "astro build && wrangler deploy --config wrangler.jsonc --env draft",
    "deploy:prod": "astro build && wrangler deploy --config wrangler.jsonc --env production",
    "migrate:ghost": "node scripts/migrate-to-ghost.js",
    "test": "npm run lint:a11y && npm run test:a11y",
    "test:a11y": "start-server-and-test preview http://localhost:4321 test:a11y:scan",
    "test:a11y:scan": "pa11y-ci --config .pa11yci.json --sitemap http://localhost:4321/sitemap-index.xml --sitemap-find https://unltd.org.uk --sitemap-replace http://localhost:4321 --sitemap-exclude /preview",
    "lint:a11y": "node scripts/link-eslint-typescript.cjs && eslint . --ext .astro,.jsx,.tsx"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^1.0.0",
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/markdoc": "^2.0.8",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@awesome.me/kit-0ff725f684": "^1.0.22",
    "@daviddarnes/storage-form": "^2.0.1",
    "@directus/sdk": "^25.0.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "^2.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/alpinejs": "^3.13.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "alpinejs": "^3.16.3",
    "astro": "^7.2.8",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.34.0",
    "maplibre-gl": "^6.6.0",
    "marked": "^18.0.11",
    "marked-gfm-heading-id": "^4.1.4",
    "micromodal": "^0.7.0",
    "moment": "^2.30.1",
    "octokit": "^5.0.5",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.421.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "resend": "^6.24.0",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "truncate": "^3.0.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.4",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/parser": "^8.68.0",
    "astro-eslint-parser": "^3.1.0",
    "baseline-browser-mapping": "^2.11.19",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "pa11y-ci": "^4.1.1",
    "prettier-plugin-astro": "^0.14.1",
    "rimraf": "^6.1.3",
    "start-server-and-test": "^3.0.12",
    "typescript-eslint-ts6": "npm:typescript@^7.0.2",
    "wrangler": "^4.126.0"
  },
  "overrides": {
    "vite": "^8"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260617.1": true
  }
}